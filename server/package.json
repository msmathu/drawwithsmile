{
  "name": "@dws/server",
  "version": "0.1.0",
  "private": true,
  "description": "DrawWithSmile real-time game server (Express + Socket.IO).",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/database/cli.ts seed"
  },
  "dependencies": {
    "@dws/shared": "0.1.0",
    "@electric-sql/pglite": "^0.5.11",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
