# DrawWithSmile server configuration.
# Copy to server/.env for local development:  cp .env.example server/.env
# NEVER commit real values. In production set these in your host's dashboard.

# --- General -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Browser origins allowed to connect (comma separated, no trailing slash).
# Production example: https://drawwithsmile.pages.dev,https://localhost,capacitor://localhost
CLIENT_ORIGINS=http://localhost:4200

# Signs guest session tokens. REQUIRED in production: 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Number of reverse proxies in front of the server (Render = 1, local = 0).
TRUST_PROXY=0

# --- Database ----------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded local database (PGlite) in PGLITE_DIR.
# Supabase: use the *Session pooler* connection string (port 5432, IPv4), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# disable | require (encrypted) | verify (encrypted + CA check, set DATABASE_CA_CERT)
DATABASE_SSL=require
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
PGLITE_DIR=.data/pglite
RUN_MIGRATIONS_ON_START=true

# --- Optional ----------------------------------------------------------------
# Serve the built web client from this server (single-origin mode, LAN parties, tunnels).
# SERVE_CLIENT_DIR=../client/drawwithsmile-web/dist/drawwithsmile-web/browser
MAX_CONNECTIONS_PER_IP=50
ROOM_ACTION_BURST=20

# --- Client build (Cloudflare Pages) ------------------------------------------
# Used by `npm run build:client`, not by the server:
# DWS_API_URL=https://drawwithsmile-api.onrender.com
